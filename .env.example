# ─────────────────────────────────────────────────────────────────────────────
# Configuration de l'agent — copie ce fichier en `.env` et renseigne tes valeurs.
# ⚠️ `.env` ne doit JAMAIS être commité (voir .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# === CHOIX DU PROVIDER LLM (le cœur de l'agnosticisme) =======================
# Valeurs possibles : mistral | groq | google_genai | openai | azure_openai |
#                     azure_ai | openai_compatible | custom
LLM_PROVIDER=mistral

# Le modèle à utiliser (dépend du provider ; ex mistral: "mistral-large-latest")
LLM_MODEL=mistral-large-latest

# Température (0 = déterministe/factuel, recommandé pour du support)
LLM_TEMPERATURE=0

# === CLÉS PAR PROVIDER (ne remplis que celle que tu utilises) ================
MISTRAL_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# --- Azure AI Foundry (Azure AI Inference) ---
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

# --- API OpenAI-compatible OU ton API maison (cas openai_compatible/custom) ---
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# === EMBEDDINGS (pour la FAQ / RAG — Phase 4) ================================
EMBEDDINGS_PROVIDER=mistral
EMBEDDINGS_MODEL=mistral-embed

# === OBSERVABILITÉ — LangSmith (Phase 2) =====================================
# Laisse `false` tant que tu n'as pas de clé LangSmith (sinon warnings).
# On passera à `true` en Phase 2, avec la clé renseignée ci-dessous.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agnostic-support-agent
# Région du compte. Par défaut US. Si ton compte est en EU (URL eu.smith...),
# DÉCOMMENTE la ligne EU — sinon tu auras une erreur 403 Forbidden.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com # compte US
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # compte EU

# === BASE DE CONNAISSANCE / STOCKAGE (Phases 4-5) ============================
# Chemin vers les fichiers FAQ à ingérer
KNOWLEDGE_DIR=./data/faq
