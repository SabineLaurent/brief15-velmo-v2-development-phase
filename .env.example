# ─────────────────────────────────────────────────────────────────────────────
# Configuration de l'agent — copie ce fichier en `.env` et renseigne tes valeurs.
# ⚠️ `.env` ne doit JAMAIS être commité (voir .gitignore).
#
# Principe : 1) choisis TON provider (section 1) ; 2) remplis SON bloc (section 2).
# Ne remplis QUE le bloc du provider choisi ; laisse les autres vides.
# ─────────────────────────────────────────────────────────────────────────────

# ============================================================================
# 1. PROVIDER LLM ACTIF (le cœur de l'agnosticisme)
# ============================================================================
# mistral | groq | google_genai | openai | openai_compatible | azure_ai | custom
#
# ⚠️ CHANGER DE PROVIDER = 1 VARIABLE + 1 EXTRA À INSTALLER.
# Chaque intégration provider est un extra optionnel du package (pyproject.toml),
# pour qu'une installation ne paie pas les SDK des 5 providers qu'elle n'utilise
# pas. La variable ci-dessous ne suffit donc pas seule :
#   mistral      → uv sync --extra mistral
#   groq         → uv sync --extra groq
#   google_genai → uv sync --extra google
#   azure_ai     → uv sync --extra azure
#   openai / openai_compatible → RIEN à installer (dépendance de base)
# Oublié ? L'agent refuse de démarrer avec un message nommant l'extra exact —
# pas un ImportError obscur (voir llm/_extras.py).
LLM_PROVIDER=openai_compatible

# Nom du modèle. Pour Azure : le NOM DU DÉPLOIEMENT créé dans Foundry.
# (un seul bouton, valable pour TOUS les providers)
LLM_MODEL=

# 0 = déterministe/factuel (recommandé pour du support)
LLM_TEMPERATURE=0

# Robustesse : re-essais (backoff auto du provider) sur 429/coupure réseau, et
# timeout par requête en secondes (vide = défaut du provider).
LLM_MAX_RETRIES=3
LLM_TIMEOUT=

# Fallback provider : si le provider PRINCIPAL est complètement HS (429 persistant,
# panne, clé invalide) MÊME après les re-essais, bascule AUTOMATIQUEMENT vers un
# 2e provider. Laisse vide = pas de fallback. C'est juste un autre couple
# (provider, modèle) — le provider choisi doit avoir SA clé renseignée en section 2.
#   ex : principal mistral (429 fréquent en free tier) → fallback groq
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Rôle « modèle rapide » (cascade latence, cf. docs/latence.md). Le routeur, le
# petit talk et la décision d'outil sont des appels FACILES sur le chemin critique
# AVANT le 1er token streamé : les faire sur un petit modèle rapide réduit le
# silence (TTFT), pendant que le modèle fort (LLM_MODEL) rédige la réponse finale.
#   Vide = pas de cascade (tout tourne sur LLM_MODEL, comme avant).
#   LLM_FAST_PROVIDER vide = même provider que le principal → si le modèle rapide
#   est déployé sur le MÊME endpoint (même base_url/clé), il suffit de renseigner
#   LLM_FAST_MODEL avec son nom de déploiement.
#     ex Azure Foundry : principal gpt-5.6-sol (fort) → rapide gpt-5.6-luna
LLM_FAST_PROVIDER=
LLM_FAST_MODEL=

# ============================================================================
# 2. CONFIG DU PROVIDER — ne remplis que le bloc de TON provider
# ============================================================================

# --- Endpoint OpenAI-compatible -------------------  LLM_PROVIDER=openai_compatible
# UN endpoint parlant l'API OpenAI : Azure OpenAI v1, vLLM, Ollama, API tierce/maison.
#   Azure : ton URL Foundry suffixée de /openai/v1
#     ex : https://<ressource>.services.ai.azure.com/openai/v1
# ⚠️ LLM_INFERENCE_API_KEY ne sert QU'à ce provider (mistral/groq/... ont leur propre clé plus bas).
# Ces mêmes endpoint + clé servent aussi aux embeddings openai_compatible (section 3).
LLM_INFERENCE_ENDPOINT=
LLM_INFERENCE_API_KEY=

# --- Mistral --------------------------------------  LLM_PROVIDER=mistral
# Clé gratuite : https://console.mistral.ai  (plan gratuit « Experiment »)
MISTRAL_API_KEY=

# --- Groq -----------------------------------------  LLM_PROVIDER=groq
# Clé gratuite : https://console.groq.com/keys  (free tier généreux, très rapide)
GROQ_API_KEY=

# --- Google Gemini --------------------------------  LLM_PROVIDER=google_genai
# Clé gratuite : https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- OpenAI (api.openai.com) ----------------------  LLM_PROVIDER=openai
# (payant, pas de free tier) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Azure AI Inference (autre moteur Foundry) ----  LLM_PROVIDER=azure_ai
# Pour Mistral/Llama/… servis NATIVEMENT (host .services.ai.azure.com/models).
# Nécessite le package langchain-azure-ai.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=

# ============================================================================
# 3. EMBEDDINGS (FAQ / RAG + mémoire long terme) — Phases 4-5
# ============================================================================
# Provider INDÉPENDANT du chat.
#   mistral | openai | google_genai | openai_compatible
#   openai_compatible → réutilise LLM_INFERENCE_ENDPOINT + LLM_INFERENCE_API_KEY ci-dessus.
EMBEDDINGS_PROVIDER=openai_compatible
# Nom du modèle/déploiement (Azure : text-embedding-3-small ; Mistral : mistral-embed)
EMBEDDINGS_MODEL=

# ============================================================================
# 4. OBSERVABILITÉ — LangSmith (Phase 2)
# ============================================================================
# Laisse `false` tant que tu n'as pas de clé (sinon warnings).
LANGSMITH_TRACING=false
# Clé gratuite : https://smith.langchain.com  (Settings → API Keys)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agnostic-support-agent
# Région : US par défaut. Compte EU → décommente la ligne EU (sinon erreur 403).
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Barème pour la ligne « coût » du rapport d'éval (`make score`) ----------
# VOLONTAIREMENT VIDES. Le rapport affiche toujours les TOKENS ; il n'affiche une
# somme d'argent que si tu renseignes le tarif de TON provider et de TON modèle.
# Aucune valeur par défaut ici : un prix codé en dur serait un chiffre que
# personne n'a vérifié, dans un document qui sert à décider, et qui périme en
# silence le jour où le provider change sa grille. Prix par MILLION de tokens.
EVAL_PRICE_PER_1M_INPUT_TOKENS=
EVAL_PRICE_PER_1M_OUTPUT_TOKENS=

# --- Le Postgres que l'ÉVALUATION peut noter (chantier 8) --------------------
# VIDE = la mémoire n'est notée que sur SQLite, et le rapport le DIT (il ne se
# contente pas d'annoncer 12/12). Renseigné = les 12 cas du corpus mémoire
# tournent DEUX fois, une par moteur — parce que R3 (l'isolation entre clients)
# est une propriété de sécurité, et que la requête de similarité qui pourrait
# ramener la ligne du voisin appartient au store : sqlite-vec d'un côté, pgvector
# de l'autre. Prouver l'un ne prouve pas l'autre, et la prod, c'est l'autre.
#
# ⚠️ Ce n'est PAS `DATABASE_URL` ci-dessus, et la distinction est délibérée :
# celle-là configure l'APPLICATION, celle-ci autorise l'éval à créer, RÉINITIALISER
# et SUPPRIMER des schémas `eval_*` dans la base visée. On ne fait pas ça dans la
# base de quelqu'un par héritage de configuration : il faut le demander.
#
# ⚠️ Viser une base JETABLE, pas celle de l'application. Il faut pgvector, donc
# l'image `pgvector/pgvector` — le plus simple est un conteneur à part :
#   docker run -d --name eval-pg -e POSTGRES_USER=agent -e POSTGRES_PASSWORD=agent \
#     -e POSTGRES_DB=agent -p 5433:5432 pgvector/pgvector:pg17
# Port 5433 exprès : disjoint du 5432 de la pile applicative, même logique que les
# ports 81xx de `make docker-up`. Pointer l'éval sur la base de l'app fonctionne
# (le harnais déplace l'extension `vector` vers `public` si besoin), mais mélange
# des schémas jetables avec de l'état qu'on veut garder.
# EVAL_DATABASE_URL=postgres://agent:agent@localhost:5433/agent

# ============================================================================
# 5. BASE DE CONNAISSANCE (Phases 4-5)
# ============================================================================
KNOWLEDGE_DIR=./data/kb-velmo

# ============================================================================
# 6. PERSISTANCE (mémoire durable) — pré-déploiement
# ============================================================================
# UN switch pour la mémoire court terme (checkpointer) ET long terme (store).
#   memory  → en RAM : perdue au redémarrage du process (démo/tests)
#   sqlite  → sur disque : survit à un redémarrage (recommandé hors démo)
#   postgres→ cible prod : une seule base pour les deux horizons (+ pgvector)
PERSISTENCE_BACKEND=memory
# Chemins des fichiers SQLite quand PERSISTENCE_BACKEND=sqlite. DEUX fichiers,
# un par horizon de mémoire (voir database/README.md) :
#   working_memory → le fil en cours + l'exécution du graphe   (clé thread_id)
#   agent_memory   → ce qu'on sait d'un client, vectorisé      (clé user_id)
# Sous database/ (gitignoré) et non data/ : data/ contient la FAQ *versionnée*, on
# n'y mélange pas un état runtime (des conversations clients) qu'on commiterait.
# Nommés d'après le RÔLE (pas le moteur) et suffixés _PATH car c'est ce qu'ils
# contiennent : un chemin de fichier — d'où un DATABASE_URL séparé plus bas, une
# chaîne de connexion étant une autre nature de valeur.
WORKING_MEMORY_DB_PATH=./database/working_memory/checkpoints.db
AGENT_MEMORY_DB_PATH=./database/agent_memory/memories.db

# --- Quand PERSISTENCE_BACKEND=postgres ---------------------------------------
# UNE seule URL pour les DEUX horizons : contrairement à SQLite (deux fichiers),
# Postgres range mémoire de travail et mémoire agent dans la MÊME base, séparées
# par SCHÉMA. La recherche sémantique sur les souvenirs tourne dans cette même
# base via pgvector (docs/architecture-cible-2026-07-25.md §3).
# Pas de valeur par défaut volontairement : une URL plausible mais fausse ferait
# démarrer l'app pour échouer plus tard, au milieu d'une requête.
# Local (docker compose) : postgres://agent:agent@postgres:5432/agent
# Azure : ajouter ?sslmode=require — le TLS y est obligatoire.
DATABASE_URL=
# Le schéma où vivent NOS tables (créé au besoin). Hors de `public` pour qu'un
# `\dt` montre notre état, et pour laisser la place à un futur schéma `knowledge`.
DATABASE_SCHEMA=agent_state

# Rétention RGPD de la mémoire long terme (données personnelles). Le store
# Postgres lance un *sweeper* en tâche de fond qui supprime les souvenirs
# périmés — la réponse concrète au droit à l'oubli. Vide = conservation infinie
# (le comportement de sqlite/memory, inchangé).
MEMORY_TTL_DAYS=365
MEMORY_TTL_SWEEP_INTERVAL_MINUTES=60

# --- Droit à l'oubli ciblé (R5) ---
# Le sweeper ci-dessus répond à « on ne garde pas éternellement » ; il ne répond
# PAS à « oublie mon numéro de commande » (il compte depuis le dernier accès, donc
# les données d'un client actif n'expirent jamais). Ça, c'est l'outil
# `forget_memory` + `make memory` — voir docs/memoire.md.
#
# Le plancher de similarité qu'un souvenir doit atteindre pour être SUPPRIMÉ sur
# demande en langage naturel. Supprimer sur une correspondance faible détruit le
# MAUVAIS fait, irréversiblement — donc cette valeur est MESURÉE, pas choisie :
# sur text-embedding-3-small, le fait visé sort à 0,40-0,59 selon la formulation,
# les faits non visés à 0,09-0,24. Un essai à 0,6 était au-dessus de toutes les
# vraies correspondances : la fonctionnalité ne supprimait jamais rien. Si tu
# montes ce seuil, revérifie qu'une suppression réelle se produit encore.
FORGET_MIN_SCORE=0.35

# --- Fenêtre de contexte : compaction (R4) ---
# Au-delà de COMPACT_AFTER_MESSAGES messages, le bloc le plus ancien est condensé
# en résumé et RETIRÉ de l'historique ; les COMPACT_KEEP_LAST_MESSAGES derniers
# restent verbatim. Sous le seuil il ne se passe rien du tout — c'est ce qui tient
# l'exigence des 30 tours conservés mot pour mot.
#   0 → kill switch : le nœud `compact` n'est pas ajouté au graphe
# Coût : UN appel LLM sur le tour qui franchit le seuil (~1 tour sur 20 ici).
COMPACT_AFTER_MESSAGES=30
# La queue gardée verbatim. À garder confortablement plus grande qu'une étape
# ReAct (assistant + résultats d'outils + réponse), sinon la queue n'est que du
# trafic d'outils et plus de la conversation.
COMPACT_KEEP_LAST_MESSAGES=10

# --- Mémoire épisodique (Phase 14) ---
# « Un cas RESSEMBLANT a-t-il déjà été bien traité ? » — des cas résolus, rejoués
# en few-shot. À la différence du sémantique, ces épisodes sont PARTAGÉS entre
# clients (c'est le but : l'agent apprend d'un cas pour servir le suivant), donc
# ils sont anonymisés à l'écriture. Voir docs/memoire.md.
#   true  → lecture (1 appel embeddings par tour support) + écriture du candidat
#   false → kill switch : prompt support identique à l'avant-Phase 14
EPISODIC_MEMORY_ENABLED=true
# Combien de cas passés on injecte. 2 est un plafond volontaire : un épisode est
# long, il concurrence la FAQ dans l'attention du modèle.
EPISODIC_RECALL_LIMIT=2
# Le plancher de pertinence — le réglage qui décide si le rappel veut dire
# quelque chose. Une recherche vectorielle renvoie TOUJOURS son meilleur match :
# sans plancher, le premier épisode écrit atterrit dans toutes les conversations.
# Dépend du modèle d'embeddings (les scores ne sont pas comparables d'un modèle à
# l'autre) : à monter si l'agent se met à citer des cas hors sujet.
EPISODIC_MIN_SCORE=0.35
# Combien de temps un fil doit rester silencieux avant d'être distillé. Rien dans
# un chat ne dit « au revoir » de façon fiable : le silence est le seul signal de
# fin de cas exploitable. La distillation elle-même tourne HORS LIGNE
# (`make consolidate`), jamais pendant un tour client.
EPISODIC_IDLE_MINUTES=30

# --- Le backend MÉTIER (port `actions/`) --------------------------------------
# ⚠️ À ne pas confondre avec PERSISTENCE_BACKEND ci-dessus. Celui-là gouverne la
# mémoire, qui est À NOUS des deux côtés (dev et prod). Celui-ci gouverne le SI du
# marchand — commandes, clients, tickets — qu'on ne possède PAS : ici on le
# DOUBLE, en prod on le DÉBRANCHE pour appeler son API (database/README.md).
#   memory → 3 commandes écrites à la main, perdues au redémarrage (défaut)
#   sqlite → la boutique peuplée par `make seed` : 14 commandes, 10 clients,
#            expéditions, retours, remboursements ; les tickets survivent
# Le défaut reste `memory` À DESSEIN : les deux adaptateurs n'ont pas la même
# convention d'identifiants (CMD-1001 vs O-2024-0103) et `eval/dataset.py` épingle
# celle de `memory`. Basculer le défaut casserait la porte d'éval sur un détail
# qui n'a rien à voir avec le comportement de l'agent.
# ⚠️ En `sqlite`, parle à l'agent en tant que client EXISTANT (ex. C-marc-dubois),
# sinon aucune commande ne t'appartient et l'agent aura raison de le dire.
SUPPORT_BACKEND=memory
# Le fichier de la doublure. Sous database/ (runtime gitignoré) et non data/ (source
# versionnée). Créé et peuplé par `make seed`.
SHOP_DB_PATH=./database/shop/shop.db

# ============================================================================
# 7. GUARDRAILS (Phase 12 — sécurité)
# ============================================================================
# Garde d'entrée (nœud `guard_input`, avant le router) : validation de taille,
# détection de prompt-injection, masquage des PII avant que le message n'atteigne
# le LLM / les outils / le store. Détecteurs agnostiques (baseline regex),
# remplaçables sans toucher au graphe.
#   true  → garde active (recommandé)
#   false → kill switch : graphe câblé comme avant (START → router), aucun overhead
GUARDRAILS_ENABLED=true
# Longueur max d'un message client (coût / DoS) avant refus.
GUARDRAILS_MAX_INPUT_CHARS=4000
# Durcissement des outils d'écriture (12-C) : plafond de longueur des champs
# générés par le LLM (sujet/corps de ticket, texte mémoire), et rate-limit
# anti-abus sur la création de ticket (N actions par fenêtre de secondes, par client).
GUARDRAILS_MAX_TOOL_FIELD_CHARS=2000
GUARDRAILS_ACTION_RATE_LIMIT=5
GUARDRAILS_ACTION_RATE_WINDOW_S=3600
# Nos PROPRES domaines de contact (liste séparée par des virgules). Le garde de
# SORTIE ne caviarde pas ces adresses : elles sont publiques et constituent la
# réponse attendue de deux fiches FAQ (`contact-pro.md`, `retractation-rgpd.md`).
# L'adresse d'un CLIENT reste caviardée, et l'entrée n'est jamais assouplie.
# Vide → toute adresse est caviardée en sortie (comportement d'avant le correctif).
GUARDRAILS_OWNED_EMAIL_DOMAINS=velmo.example

# ============================================================================
# 8. EXPOSITION HTTP (déploiement étape 1) — `make serve`
# ============================================================================
# Clé de SERVICE : prouve que l'APPELANT a le droit d'utiliser cet agent.
# ⚠️ Ce n'est PAS l'identité du client (ça, c'est USER_ID, et le prouver est
# l'étape 5 du déploiement). Son premier rôle est prosaïque : un endpoint ouvert
# branché sur une clé LLM payante se fait vider son crédit en une nuit.
#   Générer une clé :  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Échappatoire pour les runs LOCAUX seulement. Le serveur REFUSE de démarrer si
# API_KEY est vide ET que cette variable n'est pas explicitement à true — c'est
# volontaire : le mode ouvert doit être demandé par son nom, jamais subi par oubli.
# ⚠️ NE JAMAIS déployer avec true (ni sur Azure, ni derrière un tunnel public).
#
# 🎚️ C'EST LE CURSEUR local ⇄ réaliste, et il est sans danger :
#   true  → hors Docker, l'authentification cesse d'être du bruit pendant que tu
#           développes une feature (`make serve` n'écoute que sur 127.0.0.1).
#   false → comportement de la prod, exercé de bout en bout.
# Le conteneur, lui, force `false` dans `compose.yaml` quelle que soit la valeur
# ici : le cran de réalisme arrive avec Docker, garanti par le fichier et non par
# la discipline. Tu peux donc basculer cette ligne sans risque de contaminer la
# pile conteneurisée.
API_ALLOW_UNAUTHENTICATED=true

# ============================================================================
# 9. LE CLIENT CHAINLIT (déploiement étape 4) — `make ui`
# ============================================================================
# Depuis l'étape 4, le client n'importe plus l'agent : il l'APPELLE. Ces deux
# variables sont donc TOUT ce qu'il sait de lui. Elles se lisent côté CLIENT ;
# celles de la section 8 se lisent côté SERVEUR. Même sujet, deux côtés du fil.
#
# En local (`make serve` d'un côté, `make ui` de l'autre) : l'agent écoute sur
# 8000, le client sur 8001 — d'où cette URL (qui est aussi le défaut du code).
# En conteneur : `compose.yaml` la remplace par http://agent-api:8000 (le nom du
# service), et publie les ports sur **8100 / 8101** côté hôte — volontairement
# différents du dev local, pour qu'on sache toujours à QUI on parle (voir le
# commentaire de `compose.yaml`). Sur Azure : l'ingress HTTPS du Container App.
# Dans les trois cas, le code ne bouge pas — seule cette URL change.
AGENT_API_URL=http://localhost:8000
# La clé que le client PRÉSENTE — miroir de API_KEY ci-dessus, vue de l'appelant.
# Sur une seule machine, mets-y la MÊME valeur que API_KEY. Deux variables et pas
# une seule, parce qu'en vrai ces deux valeurs vivent sur deux machines
# différentes : le serveur ne partage jamais son fichier de config avec ses
# clients. Vide = aucun en-tête envoyé (OK seulement si API_ALLOW_UNAUTHENTICATED).
# Docker Compose remplit celle du conteneur `client` tout seul, depuis API_KEY.
AGENT_API_KEY=
